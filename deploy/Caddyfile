# Caddy obtient et renouvelle automatiquement le certificat HTTPS (Let's Encrypt)
{$DOMAIN} {
	root * /srv
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# la page ne peut parler qu'à elle-même et à l'agent local du visiteur
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8765; frame-ancestors 'none'"
		-Server
	}

	@exe path /download/*.exe
	header @exe Content-Disposition "attachment; filename=\"PCMonitor-Agent.exe\""
	header @exe Content-Type "application/vnd.microsoft.portable-executable"

	@html path / /index.html
	header @html Cache-Control "no-cache"
}
